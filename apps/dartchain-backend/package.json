{
  "name": "dartchain-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Scripts ops et vérification pour dartchain-backend",
  "scripts": {
    "start": "bash bin/run-with-postgres.sh",
    "smoke": "./mvnw -q test -Dtest=SmokeApiIntegrationTest",
    "smoke:api": "./mvnw -q test -Dtest=SmokeApiIntegrationTest",
    "smoke:live": "bash bin/smoke-api-live.sh",
    "verify:postgres": "./mvnw -q test -Dtest=PostgresOnlyProfileGuardTest,PersistenceAdIntegrationTest",
    "verify:prod": "bash bin/verify-prod-hardening.sh",
    "verify:prod-ha": "bash bin/verify-prod-ha.sh",
    "verify:observability": "./mvnw -q test -Dtest=ObservabilityAeIntegrationTest,ActuatorHealthIntegrationTest,NativeJsonLogLayoutTest",
    "verify:alerts": "bash bin/check-stack-alerts.sh",
    "verify:p2p": "bash bin/verify-p2p-sync.sh",
    "secrets:generate": "bash bin/generate-secrets.sh",
    "data:seed": "./mvnw -q spring-boot:run -Dspring-boot.run.profiles=seed",
    "data:import": "./mvnw -q spring-boot:run -Dspring-boot.run.profiles=postgres,data-import",
    "db:backup": "bash bin/backup-postgres.sh",
    "db:tables": "bash bin/db-tables.sh",
    "db:shell": "bash bin/db-shell.sh",
    "dev:stack": "bash bin/dev-stack.sh",
    "dev:start-detached": "bash bin/start-dev-detached.sh",
    "dev:stop-detached": "bash bin/stop-dev-detached.sh",
    "postgres:up": "bash bin/postgres-up.sh",
    "postgres:run": "bash bin/run-with-postgres.sh",
    "verify:commercial": "./mvnw -q test -Dtest=CommercialModeIntegrationTest",
    "verify:api": "./mvnw -q test -Dtest=ApiV1ContractIntegrationTest",
    "verify:auth": "./mvnw -q test -Dtest=AuthAbIntegrationTest",
    "verify:ac": "./mvnw -q test -Dtest=AuthAcIntegrationTest",
    "verify:ad": "./mvnw -q test -Dtest=PersistenceAdIntegrationTest,EvmCryptoUtilsTest,PostgresOnlyProfileGuardTest",
    "verify:ae": "./mvnw -q test -Dtest=ObservabilityAeIntegrationTest,NativeJsonLogLayoutTest,ApplicationMetricsCollectorTest",
    "verify:af": "./mvnw -q test -Dtest=AdminPanelAfIntegrationTest",
    "verify:secrets": "bash bin/verify-secrets.sh",
    "verify:ah": "./mvnw -q test -Dtest=ProductionSecretPolicyTest,ProductCommercialGuardTest && bash bin/verify-secrets.sh",
    "verify:release": "./mvnw -q verify"
  }
}
