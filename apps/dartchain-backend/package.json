{
  "name": "dartchain-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Scripts ops et vérification pour dartchain-backend",
  "scripts": {
    "start": "bash scripts/run-with-postgres.sh",
    "smoke": "bash scripts/smoke-api.sh",
    "smoke:api": "bash scripts/smoke-api.sh",
    "verify:postgres": "bash scripts/verify-postgres-only.sh",
    "verify:prod": "bash scripts/verify-prod-hardening.sh",
    "verify:prod-ha": "bash scripts/verify-prod-ha.sh",
    "verify:observability": "bash scripts/verify-observability.sh",
    "verify:alerts": "bash scripts/check-stack-alerts.sh",
    "verify:p2p": "bash scripts/verify-p2p-sync.sh",
    "secrets:generate": "bash scripts/generate-secrets.sh",
    "data:seed": "bash scripts/seed-local-data.sh",
    "data:import": "bash scripts/import-json-to-postgres.sh",
    "db:backup": "bash scripts/backup-postgres.sh",
    "db:tables": "bash scripts/db-tables.sh",
    "db:shell": "bash scripts/db-shell.sh",
    "dev:stack": "bash scripts/dev-stack.sh",
    "postgres:up": "bash scripts/postgres-up.sh",
    "postgres:run": "bash scripts/run-with-postgres.sh",
    "verify:commercial": "bash scripts/verify-commercial.sh",
    "verify:api": "bash scripts/verify-api-contract.sh",
    "verify:auth": "./mvnw -q test -Dtest=AuthAbIntegrationTest",
    "verify:ac": "./mvnw -q test -Dtest=AuthAcIntegrationTest",
    "verify:ad": "./mvnw -q test -Dtest=PersistenceAdIntegrationTest,EvmCryptoUtilsTest,PostgresOnlyProfileGuardTest",
    "verify:ae": "./mvnw -q test -Dtest=ObservabilityAeIntegrationTest,NativeJsonLogLayoutTest,ApplicationMetricsCollectorTest",
    "verify:af": "./mvnw -q test -Dtest=AdminPanelAfIntegrationTest",
    "verify:secrets": "bash scripts/verify-secrets.sh",
    "verify:ah": "bash scripts/verify-ah.sh"
  }
}
