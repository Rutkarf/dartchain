{
  "/api": {
    "target": "http://127.0.0.1:8080",
    "secure": false,
    "changeOrigin": true
  },
  "/ws": {
    "target": "http://127.0.0.1:8080",
    "secure": false,
    "ws": true,
    "changeOrigin": true
  },
  "/overpass": {
    "target": "https://overpass-api.de",
    "secure": true,
    "changeOrigin": true,
    "pathRewrite": {
      "^/overpass": "/api/interpreter"
    }
  }
}
