{
  "/api": {
    "target": "http://127.0.0.1:8080",
    "secure": false,
    "changeOrigin": true
  },
  "/ws": {
    "target": "http://127.0.0.1:8080",
    "secure": false,
    "ws": true,
    "changeOrigin": true
  },
  "/overpass": {
    "target": "https://overpass-api.de",
    "secure": true,
    "changeOrigin": true,
    "timeout": 25000,
    "headers": {
      "User-Agent": "DartChain-MetaverseBB/1.0"
    },
    "pathRewrite": {
      "^/overpass": "/api/interpreter"
    }
  },
  "/overpass-alt": {
    "target": "https://overpass.kumi.systems",
    "secure": true,
    "changeOrigin": true,
    "timeout": 25000,
    "headers": {
      "User-Agent": "DartChain-MetaverseBB/1.0"
    },
    "pathRewrite": {
      "^/overpass-alt": "/api/interpreter"
    }
  }
}
