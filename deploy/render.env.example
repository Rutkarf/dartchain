# Variables pour Render (Web Service Docker + Postgres)
# Copier les valeurs dans le dashboard Render ou utiliser deploy/render.yaml

# --- Image Docker Hub ---
# DOCKERHUB_USER=rutkarf
# IMAGE=docker.io/${DOCKERHUB_USER}/dartchain-backend:1.0.0

# --- Service ---
PORT=8080
SPRING_PROFILES_ACTIVE=postgres,prod
DARTCHAIN_PERSISTENCE_MODE=postgres
JAVA_TOOL_OPTIONS=-Xmx384m

# --- Postgres (Render : host/port/db/user/password auto via deploy/render.yaml) ---
# Override JDBC complet si besoin :
# DATABASE_JDBC_URL=jdbc:postgresql://HOST:5432/dartchain
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=dartchain
DATABASE_USERNAME=dartchain
DATABASE_PASSWORD=CHANGE_ME

# --- Secrets (générer : cd apps/dartchain-backend && npm run secrets:generate) ---
DARTCHAIN_JWT_SECRET=CHANGE_ME_MIN_32_CHARS
DARTCHAIN_ACTUATOR_TOKEN=CHANGE_ME_MIN_24_CHARS

# --- CORS : URL Cloudflare Pages du frontend ---
DARTCHAIN_CORS_EXTRA=https://YOUR-PROJECT.pages.dev

# --- Health check Render ---
# Path: /api/health
# Port: 8080
