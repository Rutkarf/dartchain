# Copie ce fichier en .env à la racine du monorepo, ou génère des secrets aléatoires :
#
#   cd apps/dartchain-backend && npm run secrets:generate
#
# Variables minimales (voir deploy/render.env.example pour la prod) :
#
# POSTGRES_DB=dartchain
# POSTGRES_USER=dartchain
# POSTGRES_PASSWORD=change-me-min-16-chars
# DARTCHAIN_JWT_SECRET=change-me-min-32-chars
# DARTCHAIN_ACTUATOR_TOKEN=change-me-min-24-chars
